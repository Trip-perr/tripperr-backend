# Tripperr API environment variables
# Copy this file to `.env` and adjust values. Do NOT commit `.env`.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Mongo
MONGODB_URI=mongodb://localhost:27017/tripperr_dev

# JWT (MUST be at least 32 ASCII chars)
JWT_SECRET=please-change-me-to-a-strong-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=30
JWT_ISSUER=tripperr-api

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
